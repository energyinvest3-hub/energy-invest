# PERFECT PAY
PERFECTPAY_API_TOKEN=
PERFECTPAY_WEBHOOK_TOKEN=

# Um checkout padrão:
PERFECTPAY_CHECKOUT_URL=https://go.perfectpay.com.br/SEU_LINK

# OU um checkout por valor:
# PERFECTPAY_CHECKOUTS_JSON={"50":"https://go.perfectpay.com.br/AAA","100":"https://go.perfectpay.com.br/BBB","200":"https://go.perfectpay.com.br/CCC"}

# Recomendado para impedir que outro produto/plano credite a carteira:
PERFECTPAY_PRODUCT_CODE=
PERFECTPAY_PLAN_CODE=

# SUPABASE: secret key apenas no backend/Vercel.
SUPABASE_SECRET_KEY=

# Já existentes:
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# DEPOSITS_DISABLED=false
