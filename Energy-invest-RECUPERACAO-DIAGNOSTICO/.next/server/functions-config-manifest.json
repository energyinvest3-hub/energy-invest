{
  "version": 1,
  "functions": {
    "/_middleware": {
      "runtime": "nodejs",
      "matchers": [
        {
          "regexp": "^(?:\\/(_next\\/data\\/[^/]{1,}))?(?:\\/((?!_next\\/static|_next\\/image|.*\\.(?:png|jpg|svg|ico)$).*))(\\.json|\\.rsc|\\.segments\\/.+\\.segment\\.rsc)?[\\/#\\?]?$",
          "originalSource": "/((?!_next/static|_next/image|.*\\.(?:png|jpg|svg|ico)$).*)"
        }
      ]
    },
    "/api/payments/perfectpay/deposit": {},
    "/api/payments/perfectpay/status": {},
